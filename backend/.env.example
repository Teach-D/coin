NODE_ENV=local

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=coinbattle
DB_PASSWORD=coinbattle
DB_NAME=coinbattle

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-base64-encoded-secret-key-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AES Encryption
AES_KEY=your-base64-encoded-aes-key

# OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/oauth2/callback/google
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:3000/oauth2/callback/kakao
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# App
APP_BASE_URL=http://localhost:5173

# S3
S3_BUCKET=coin-battle-cards
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
